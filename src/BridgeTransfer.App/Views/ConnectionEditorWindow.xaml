<c:ThemedWindow x:Class="BridgeTransfer.App.Views.ConnectionEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:BridgeTransfer.App.Controls"
        Title="Connection" Width="620" SizeToContent="Height" ResizeMode="NoResize" MaxHeight="900">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24,20,24,20">
      <TextBlock x:Name="Heading" Style="{StaticResource Text.Title}" Text="New connection" />
      <TextBlock Style="{StaticResource Text.Muted}" Margin="0,6,0,0"
                 Text="Passwords and key passphrases are never saved. They are asked for when you connect and kept in memory only for that session." />

      <Grid Margin="0,16,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="130" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="90" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Label Content="_Name" Target="{Binding ElementName=NameBox}" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center" Padding="0" />
        <TextBox x:Name="NameBox" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,4" Tag="For example: Lab VM" />
        <Label Grid.Row="1" Content="_Host" Target="{Binding ElementName=HostBox}" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center" Padding="0" />
        <TextBox x:Name="HostBox" Grid.Row="1" Grid.Column="1" Margin="0,4" Tag="Host name or IP address" />
        <Label Grid.Row="1" Grid.Column="2" Content="_Port" Target="{Binding ElementName=PortBox}" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center" Margin="12,0,8,0" Padding="0" />
        <TextBox x:Name="PortBox" Grid.Row="1" Grid.Column="3" Margin="0,4" />
        <Label Grid.Row="2" Content="_User name" Target="{Binding ElementName=UserBox}" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center" Padding="0" />
        <TextBox x:Name="UserBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,4" Tag="Your user on the Linux VM" />
      </Grid>

      <TextBlock Style="{StaticResource Text.Section}" Text="Sign in with" Margin="0,18,0,8" />
      <StackPanel Orientation="Horizontal">
        <RadioButton x:Name="KeyRadio" Content="Private _key" GroupName="auth" Checked="OnAuthChanged" />
        <RadioButton x:Name="PasswordRadio" Content="Pass_word" GroupName="auth" Margin="24,0,0,0" Checked="OnAuthChanged" />
      </StackPanel>
      <Grid x:Name="KeyPanel" Margin="0,10,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBox x:Name="KeyBox" Tag="Path to the private key file, e.g. C:\Users\you\.ssh\id_ed25519" />
        <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Click="OnBrowseKey" />
        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" x:Name="KeyFormats" Style="{StaticResource Text.Small}" TextWrapping="Wrap" Margin="0,6,0,0" />
      </Grid>

      <TextBlock Style="{StaticResource Text.Section}" Text="Start in these folders (optional)" Margin="0,18,0,8" />
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="130" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Label Content="This _computer" Target="{Binding ElementName=LocalBox}" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center" Padding="0" />
        <TextBox x:Name="LocalBox" Grid.Column="1" Margin="0,4" Tag="Your home folder if empty" />
        <Button Grid.Column="2" Content="Browse…" Margin="8,4,0,4" Click="OnBrowseLocal" />
        <Label Grid.Row="1" Content="Linux _VM" Target="{Binding ElementName=RemoteBox}" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center" Padding="0" />
        <TextBox x:Name="RemoteBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4" Tag="Your home folder on the VM if empty, e.g. /home/you/data" />
      </Grid>

      <StackPanel x:Name="IdentityPanel" Margin="0,18,0,0">
        <TextBlock Style="{StaticResource Text.Section}" Text="Server identity" Margin="0,0,0,8" />
        <Border Style="{StaticResource Card}" Padding="12,8">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="IdentityText" Style="{StaticResource Text.Mono}" VerticalAlignment="Center" />
            <Button x:Name="ForgetButton" Grid.Column="1" Content="Forget trusted key…" Margin="12,0,0,0" Click="OnForget"
                    ToolTip="Remove the trusted host key for this host and port. The next connection shows the server's fingerprint for you to verify again." />
          </Grid>
        </Border>
      </StackPanel>

      <Border x:Name="TestResult" Style="{StaticResource Banner}" Margin="0,16,0,0" Visibility="Collapsed">
        <StackPanel Orientation="Horizontal">
          <c:Glyph x:Name="TestGlyph" Data="{StaticResource Icon.Info}" VerticalAlignment="Top" Margin="0,1,8,0" />
          <TextBlock x:Name="TestText" TextWrapping="Wrap" MaxWidth="520" />
        </StackPanel>
      </Border>
      <TextBlock x:Name="Problems" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed" />

      <Grid Margin="0,20,0,0">
        <Button x:Name="TestButton" Content="Test connection" HorizontalAlignment="Left" Click="OnTest" MinWidth="130" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Cancel" IsCancel="True" MinWidth="96" />
          <Button Style="{StaticResource Button.Primary}" Content="Save" IsDefault="True" MinWidth="96" Margin="8,0,0,0" Click="OnSave" />
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</c:ThemedWindow>
