<c:ThemedWindow x:Class="BridgeTransfer.App.Views.JobDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:BridgeTransfer.App.Controls"
        Title="Transfer details" Width="860" Height="560" MinWidth="560" MinHeight="360">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock x:Name="Heading" Style="{StaticResource Text.Title}" TextTrimming="CharacterEllipsis" />
    <TextBlock x:Name="Summary" Grid.Row="1" Style="{StaticResource Text.Muted}" Margin="0,6,0,12" />
    <Border Grid.Row="2" Style="{StaticResource Card}" ClipToBounds="True">
      <DataGrid x:Name="Grid" Margin="1" AutomationProperties.Name="Items in this transfer">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Item" Binding="{Binding Path}" Width="2*" />
          <DataGridTextColumn Header="Result" Binding="{Binding State}" Width="150" />
          <DataGridTextColumn Header="Explanation" Binding="{Binding Message}" Width="3*">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="ToolTip" Value="{Binding Message}" />
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Border>
    <Grid Grid.Row="3" Margin="0,14,0,0">
      <CheckBox x:Name="OnlyProblems" Content="Show only items that need attention" IsChecked="True" Checked="OnFilter" Unchecked="OnFilter" VerticalAlignment="Center" />
      <Button Content="Close" IsCancel="True" IsDefault="True" HorizontalAlignment="Right" MinWidth="96" />
    </Grid>
  </Grid>
</c:ThemedWindow>
