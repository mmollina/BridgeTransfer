<c:ThemedWindow x:Class="BridgeTransfer.App.Views.TransferConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:BridgeTransfer.App.Controls"
        Title="Start transfer" Width="580" SizeToContent="Height" ResizeMode="NoResize" MaxHeight="760">
  <StackPanel Margin="24,20,24,20">
    <StackPanel Orientation="Horizontal">
      <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource Brush.AccentSoft}">
        <c:Glyph Data="{StaticResource Icon.Transfer}" Width="18" Height="18" Foreground="{DynamicResource Brush.AccentForeground}" />
      </Border>
      <TextBlock x:Name="Heading" Style="{StaticResource Text.Title}" Margin="12,5,0,0" TextWrapping="Wrap" MaxWidth="470" />
    </StackPanel>
    <ScrollViewer Margin="44,10,0,0" MaxHeight="360" VerticalScrollBarVisibility="Auto">
      <TextBox x:Name="Body" Style="{StaticResource Text.Mono}" FontFamily="{StaticResource Font.UI}" FontSize="13" />
    </ScrollViewer>
    <Grid Margin="44,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="If a file already exists" VerticalAlignment="Center" Margin="0,0,10,0" />
      <ComboBox x:Name="ExistsBox" Grid.Column="1" AutomationProperties.Name="If a file already exists" />
    </Grid>
    <TextBlock x:Name="ExistsNote" Style="{StaticResource Text.Small}" Margin="44,6,0,0" TextWrapping="Wrap"
               Text="A file that is newer on the destination is never replaced automatically; you are asked about it." />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button Content="Cancel" IsCancel="True" MinWidth="96" />
      <Button x:Name="StartButton" Style="{StaticResource Button.Primary}" IsDefault="True" MinWidth="110" Margin="8,0,0,0" Click="OnStart" />
    </StackPanel>
  </StackPanel>
</c:ThemedWindow>
