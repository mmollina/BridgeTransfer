<c:ThemedWindow x:Class="BridgeTransfer.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:BridgeTransfer.App.Controls"
        xmlns:v="clr-namespace:BridgeTransfer.App.Views"
        Title="{Binding AppTitle}" Width="1280" Height="820" MinWidth="980" MinHeight="600"
        Icon="/Assets/BridgeTransfer.ico">
  <c:ThemedWindow.Resources>
    <c:BoolToVisibilityConverter x:Key="Vis" />
    <c:BoolToVisibilityConverter x:Key="NotVis" Invert="True" />
    <c:ResourceKeyConverter x:Key="Res" />
  </c:ThemedWindow.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="260" />
      <RowDefinition Height="Auto" />
      <RowDefinition x:Name="QueueRow" Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ===== Top bar ===== -->
    <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="8,8,12,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button Style="{StaticResource Button.Icon}" Command="{Binding ToggleSidebarCommand}" ToolTip="Show or hide the sidebar" AutomationProperties.Name="Toggle sidebar">
          <c:Glyph Data="{StaticResource Icon.Sidebar}" />
        </Button>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,20,0" VerticalAlignment="Center">
          <Image Source="/Assets/BridgeTransfer-64.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality" />
          <TextBlock Text="{Binding AppTitle}" FontSize="15" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Connection summary and state -->
        <Border Grid.Column="2" Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="8" Padding="10,4,6,4">
          <StackPanel Orientation="Horizontal">
            <c:Glyph Data="{StaticResource Icon.Server}" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
            <StackPanel Margin="8,0,12,0" VerticalAlignment="Center" MinWidth="150" MaxWidth="280">
              <TextBlock Text="{Binding ConnectionTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding ConnectionSubtitle}" Style="{StaticResource Text.Small}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Border x:Name="StatusPill" Style="{StaticResource Pill}" VerticalAlignment="Center" Margin="0,0,10,0"
                    Background="{DynamicResource Brush.SurfaceHover}" BorderBrush="{DynamicResource Brush.Border}" AutomationProperties.Name="{Binding StatusLabel}">
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding StatusLabel}" FontSize="12" Margin="6,0,0,0" />
              </StackPanel>
            </Border>
            <Button Style="{StaticResource Button.Primary}" Command="{Binding ConnectCommand}" Visibility="{Binding IsConnected, Converter={StaticResource NotVis}}" MinWidth="100">
              <StackPanel Orientation="Horizontal">
                <c:Glyph Data="{StaticResource Icon.Plug}" Margin="0,0,6,0" />
                <TextBlock Text="Connect" />
              </StackPanel>
            </Button>
            <Button Command="{Binding CancelConnectCommand}" Content="Cancel" Margin="6,0,0,0" Visibility="{Binding IsConnecting, Converter={StaticResource Vis}}" />
            <Button Command="{Binding ReconnectCommand}" Content="Reconnect" Margin="6,0,0,0" Visibility="{Binding IsLost, Converter={StaticResource Vis}}" />
            <Button Command="{Binding DisconnectCommand}" Visibility="{Binding IsConnected, Converter={StaticResource Vis}}" MinWidth="110">
              <StackPanel Orientation="Horizontal">
                <c:Glyph Data="{StaticResource Icon.Unplug}" Margin="0,0,6,0" />
                <TextBlock Text="Disconnect" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>

        <StackPanel Grid.Column="4" Orientation="Horizontal">
          <Button Command="{Binding CompareCommand}" ToolTip="Compare a folder on this computer with a folder on the Linux VM and review a one-way synchronization">
            <StackPanel Orientation="Horizontal">
              <c:Glyph Data="{StaticResource Icon.Compare}" Margin="0,0,6,0" />
              <TextBlock Text="Compare folders" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource Button.Icon}" Command="{Binding ToggleThemeCommand}" Margin="8,0,0,0" ToolTip="Switch between light and dark theme" AutomationProperties.Name="Switch theme">
            <c:Glyph x:Name="ThemeGlyph" Data="{StaticResource Icon.Moon}" />
          </Button>
          <Button Style="{StaticResource Button.Icon}" Command="{Binding OpenSettingsCommand}" ToolTip="Settings" AutomationProperties.Name="Settings">
            <c:Glyph Data="{StaticResource Icon.Settings}" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ===== Notice ===== -->
    <Border Grid.Row="1" Style="{StaticResource Banner}" Margin="12,10,12,0" Visibility="{Binding Notice, Converter={StaticResource Vis}}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <c:Glyph Data="{StaticResource Icon.Info}" Foreground="{DynamicResource Brush.Warning}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding Notice}" TextWrapping="Wrap" Margin="8,0" VerticalAlignment="Center" />
        <Button Grid.Column="2" Style="{StaticResource Button.Icon}" Command="{Binding DismissNoticeCommand}" AutomationProperties.Name="Dismiss" ToolTip="Dismiss">
          <c:Glyph Data="{StaticResource Icon.Close}" />
        </Button>
      </Grid>
    </Border>

    <!-- ===== Sidebar + panels ===== -->
    <Grid Grid.Row="2" Margin="12,12,12,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="SidebarColumn" Width="212" MinWidth="0" MaxWidth="360" />
        <ColumnDefinition x:Name="SidebarSplitColumn" Width="12" />
        <ColumnDefinition Width="*" MinWidth="280" />
        <ColumnDefinition Width="136" />
        <ColumnDefinition Width="*" MinWidth="280" />
      </Grid.ColumnDefinitions>

      <!-- Sidebar -->
      <Border x:Name="Sidebar" Style="{StaticResource Card}" Padding="10,10,10,10">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="80" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="60" />
          </Grid.RowDefinitions>
          <Grid Margin="4,0,0,6">
            <TextBlock Style="{StaticResource Text.Section}" Text="Connections" VerticalAlignment="Center" />
            <Button Style="{StaticResource Button.Icon}" HorizontalAlignment="Right" Command="{Binding NewProfileCommand}" ToolTip="Add a connection" AutomationProperties.Name="Add a connection">
              <c:Glyph Data="{StaticResource Icon.Plus}" />
            </Button>
          </Grid>
          <ListBox x:Name="ProfileList" Grid.Row="1" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" AutomationProperties.Name="Saved connections"
                   MouseDoubleClick="OnProfileDoubleClick">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Background="Transparent" ToolTip="{Binding Summary}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <c:Glyph Data="{StaticResource Icon.Server}" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Top" Margin="0,2,8,0" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Small}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <Grid.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="Connect" Command="{Binding PlacementTarget.Tag.ConnectCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                      <MenuItem Header="Edit…" Command="{Binding PlacementTarget.Tag.EditProfileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                      <MenuItem Header="Duplicate" Command="{Binding PlacementTarget.Tag.DuplicateProfileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                      <Separator />
                      <MenuItem Header="Remove from list…" Command="{Binding PlacementTarget.Tag.RemoveProfileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                    </ContextMenu>
                  </Grid.ContextMenu>
                  <Grid.Tag>
                    <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Window}" />
                  </Grid.Tag>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Grid.Row="1" VerticalAlignment="Top" Margin="4,4,4,0" Visibility="{Binding Profiles.Count, Converter={StaticResource NotVis}}">
            <TextBlock Style="{StaticResource Text.Small}" TextWrapping="Wrap" Text="No saved connections yet. Add your Linux VM once; passwords are never stored." />
            <Button Content="Add connection" Command="{Binding NewProfileCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" />
          </StackPanel>
          <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding Profiles.Count, Converter={StaticResource Vis}}">
            <Button Content="Edit" Command="{Binding EditProfileCommand}" CommandParameter="{Binding SelectedProfile}" MinWidth="70" />
            <TextBlock Text="Double-click to connect" Style="{StaticResource Text.Small}" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" Width="120" />
          </StackPanel>
          <Grid Grid.Row="3" Margin="4,16,0,6">
            <TextBlock Style="{StaticResource Text.Section}" Text="Folder pairs" VerticalAlignment="Center" />
            <Button Style="{StaticResource Button.Icon}" HorizontalAlignment="Right" Command="{Binding AddBookmarkCommand}"
                    ToolTip="Save the two folders shown now as a folder pair" AutomationProperties.Name="Save folder pair">
              <c:Glyph Data="{StaticResource Icon.Plus}" />
            </Button>
          </Grid>
          <Grid Grid.Row="4">
            <ListBox ItemsSource="{Binding Bookmarks}" AutomationProperties.Name="Folder pairs">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                  <Setter Property="Padding" Value="0" />
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource Button.Ghost}" HorizontalContentAlignment="Stretch" Padding="8,6"
                          Command="{Binding DataContext.OpenBookmarkCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                          ToolTip="{Binding LocalRoot}" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <c:Glyph Data="{StaticResource Icon.Pair}" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Top" Margin="0,2,8,0" />
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding RemoteRoot}" Style="{StaticResource Text.Small}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Grid>
                    <Button.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Open both folders" Command="{Binding PlacementTarget.Tag.OpenBookmarkCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                        <MenuItem Header="Rename…" Command="{Binding PlacementTarget.Tag.RenameBookmarkCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                        <MenuItem Header="Remove from list…" Command="{Binding PlacementTarget.Tag.RemoveBookmarkCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                      </ContextMenu>
                    </Button.ContextMenu>
                  </Button>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Style="{StaticResource Text.Small}" TextWrapping="Wrap" Margin="4,4,4,0" IsHitTestVisible="False"
                       Text="Save a local folder and a VM folder as a pair to open both with one click."
                       Visibility="{Binding Bookmarks.Count, Converter={StaticResource NotVis}}" />
          </Grid>
        </Grid>
      </Border>
      <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Width="12" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" />

      <v:FilePanelView x:Name="LocalView" Grid.Column="2" DataContext="{Binding Local}" />

      <!-- Transfer actions between the panels. The splitter behind them resizes the two panels. -->
      <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" ToolTip="Drag to resize the panels" />
      <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center" Width="120" Panel.ZIndex="1">
        <Button Style="{StaticResource Button.Primary}" Command="{Binding UploadCommand}" Padding="8,10" ToolTip="{Binding UploadToolTip}" ToolTipService.ShowOnDisabled="True"
                AutomationProperties.Name="Upload: copy selection from this computer to the Linux VM">
          <StackPanel>
            <c:Glyph Data="{StaticResource Icon.ArrowRight}" Width="22" Height="22" />
            <TextBlock Text="Upload" HorizontalAlignment="Center" Margin="0,4,0,0" />
            <TextBlock Text="to Linux VM" HorizontalAlignment="Center" FontSize="11" FontWeight="Normal" Opacity="0.85" />
          </StackPanel>
        </Button>
        <Button Style="{StaticResource Button.Primary}" Command="{Binding DownloadCommand}" Padding="8,10" Margin="0,12,0,0" ToolTip="{Binding DownloadToolTip}" ToolTipService.ShowOnDisabled="True"
                AutomationProperties.Name="Download: copy selection from the Linux VM to this computer">
          <StackPanel>
            <c:Glyph Data="{StaticResource Icon.ArrowLeft}" Width="22" Height="22" />
            <TextBlock Text="Download" HorizontalAlignment="Center" Margin="0,4,0,0" />
            <TextBlock Text="to this computer" HorizontalAlignment="Center" FontSize="11" FontWeight="Normal" Opacity="0.85" />
          </StackPanel>
        </Button>
        <TextBlock Style="{StaticResource Text.Small}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,14,0,0" Text="Or drag items from one panel to the other." />
      </StackPanel>

      <v:FilePanelView x:Name="RemoteView" Grid.Column="4" DataContext="{Binding Remote}" />
    </Grid>

    <!-- ===== Queue ===== -->
    <GridSplitter x:Name="QueueSplitter" Grid.Row="3" Height="10" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" ResizeDirection="Rows" Margin="12,0" />
    <Border Grid.Row="4" Style="{StaticResource Card}" Margin="12,0,12,0" DataContext="{Binding Queue}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="6,6,8,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button Style="{StaticResource Button.Ghost}" Command="{Binding DataContext.ToggleQueueCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                  AutomationProperties.Name="Show or hide transfers" ToolTip="Show or hide the transfer list" Padding="6,4">
            <StackPanel Orientation="Horizontal">
              <c:Glyph x:Name="QueueChevron" Data="{StaticResource Icon.ChevronDown}" />
              <TextBlock Text="Transfers" FontWeight="SemiBold" Margin="6,0,0,0" />
            </StackPanel>
          </Button>
          <TextBlock Grid.Column="1" Text="{Binding Summary}" Style="{StaticResource Text.Small}" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis" />
          <StackPanel Grid.Column="2" Orientation="Horizontal">
            <Button Command="{Binding DataContext.ReviewInterruptedCommand, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,8,0" MinHeight="30" Padding="10,4"
                    Visibility="{Binding DataContext.HasInterrupted, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}}"
                    ToolTip="Transfers that did not finish in the last session. Review them; nothing restarts automatically.">
              <StackPanel Orientation="Horizontal">
                <c:Glyph Data="{StaticResource Icon.Warning}" Foreground="{DynamicResource Brush.Warning}" Margin="0,0,6,0" />
                <TextBlock Text="{Binding DataContext.InterruptedCount, RelativeSource={RelativeSource AncestorType=Window}, StringFormat='Interrupted ({0})…'}" />
              </StackPanel>
            </Button>
            <ToggleButton IsChecked="{Binding StopStartingNew}" Padding="10,4" MinHeight="30"
                          ToolTip="Files already being copied finish; no new files start until you turn this off.">
              <StackPanel Orientation="Horizontal">
                <c:Glyph Data="{StaticResource Icon.Stop}" Margin="0,0,6,0" />
                <TextBlock Text="Stop starting new files" />
              </StackPanel>
            </ToggleButton>
            <Button Content="Cancel selected" Command="{Binding CancelSelectedCommand}" Margin="8,0,0,0" MinHeight="30" Padding="10,4" />
            <Button Content="Cancel all" Command="{Binding CancelAllCommand}" Margin="8,0,0,0" MinHeight="30" Padding="10,4" />
            <Button Content="Retry failed" Command="{Binding RetryFailedCommand}" Margin="8,0,0,0" MinHeight="30" Padding="10,4" />
            <Button Content="Clear finished" Command="{Binding ClearFinishedCommand}" Margin="8,0,0,0" MinHeight="30" Padding="10,4" />
          </StackPanel>
        </Grid>
        <Grid Grid.Row="1" x:Name="QueueBody">
          <DataGrid x:Name="QueueGrid" ItemsSource="{Binding Jobs}" SelectionMode="Extended" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Brush.Border}" RowHeight="44"
                    AutomationProperties.Name="Transfer queue" SelectionChanged="OnQueueSelectionChanged" Margin="0,0,0,6">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="Transfer" Width="2*" MinWidth="200">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <c:Glyph Data="{Binding DirectionIcon, Converter={StaticResource Res}}" Foreground="{DynamicResource Brush.AccentForeground}" VerticalAlignment="Center" Margin="0,0,8,0" />
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Text.Small}" TextTrimming="CharacterEllipsis" Text="{Binding DirectionDetail}" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="From → To" Width="2.4*" MinWidth="180">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel VerticalAlignment="Center" ToolTip="{Binding Destination}">
                      <TextBlock Text="{Binding Source}" TextTrimming="CharacterEllipsis" Style="{StaticResource Text.Small}" />
                      <TextBlock Text="{Binding Destination, StringFormat='→ {0}'}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="State" Width="1.5*" MinWidth="150">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding Message}">
                      <c:Glyph x:Name="StateGlyph" Data="{Binding StateIcon, Converter={StaticResource Res}}" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,6,0" />
                      <TextBlock Text="{Binding StateText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding StateTone}" Value="ok">
                        <Setter TargetName="StateGlyph" Property="Foreground" Value="{DynamicResource Brush.Success}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding StateTone}" Value="warn">
                        <Setter TargetName="StateGlyph" Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding StateTone}" Value="bad">
                        <Setter TargetName="StateGlyph" Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding StateTone}" Value="active">
                        <Setter TargetName="StateGlyph" Property="Foreground" Value="{DynamicResource Brush.AccentForeground}" />
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Progress" Width="2*" MinWidth="190">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel VerticalAlignment="Center">
                      <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}" />
                      <TextBlock Style="{StaticResource Text.Small}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding BytesText, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding FilesText, Mode=OneWay}" />
                      </TextBlock>
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Speed" Width="120">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding SpeedText}" />
                      <TextBlock Text="{Binding RemainingText}" Style="{StaticResource Text.Small}" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="" Width="170">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                      <Button Content="Decide…" Style="{StaticResource Button.Primary}" MinHeight="26" Padding="10,2" Margin="0,0,6,0"
                              Visibility="{Binding IsWaiting, Converter={StaticResource Vis}}"
                              Command="{Binding DataContext.Queue.ResolveWaitingCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                      <Button Content="Details" Style="{StaticResource Button.Link}"
                              Command="{Binding DataContext.Queue.ShowDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,24,0,0" IsHitTestVisible="False"
                     Text="Transfers you start appear here. Select items in a panel and use Upload or Download."
                     Visibility="{Binding HasJobs, Converter={StaticResource NotVis}}" />
        </Grid>
      </Grid>
    </Border>

    <!-- ===== Status bar ===== -->
    <Border Grid.Row="5" Margin="0,8,0,0" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="14,5">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding OperationText}" Style="{StaticResource Text.Small}" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="1" Text="{Binding SelectionStatus}" Style="{StaticResource Text.Small}" Margin="16,0" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="2" Text="{Binding ConnectionStatusText}" Style="{StaticResource Text.Small}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
      </Grid>
    </Border>
  </Grid>
</c:ThemedWindow>
