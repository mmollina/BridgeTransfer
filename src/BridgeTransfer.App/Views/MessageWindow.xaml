<c:ThemedWindow x:Class="BridgeTransfer.App.Views.MessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:BridgeTransfer.App.Controls"
        Title="BridgeTransfer" Width="520" SizeToContent="Height" ResizeMode="NoResize" MaxHeight="760">
  <Grid Margin="24,20,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal">
      <Border x:Name="IconBadge" Width="32" Height="32" CornerRadius="16" Background="{DynamicResource Brush.AccentSoft}" VerticalAlignment="Top">
        <c:Glyph x:Name="IconGlyph" Width="18" Height="18" Data="{StaticResource Icon.Info}" Foreground="{DynamicResource Brush.AccentForeground}" />
      </Border>
      <TextBlock x:Name="Heading" Style="{StaticResource Text.Title}" Margin="12,5,0,0" TextWrapping="Wrap" MaxWidth="420" />
    </StackPanel>
    <ScrollViewer Grid.Row="1" Margin="44,10,0,0" MaxHeight="420" VerticalScrollBarVisibility="Auto">
      <TextBox x:Name="Body" Style="{StaticResource Text.Mono}" FontFamily="{StaticResource Font.UI}" FontSize="13" />
    </ScrollViewer>
    <StackPanel Grid.Row="2" x:Name="DetailsArea" Margin="44,12,0,0" Visibility="Collapsed">
      <Button x:Name="DetailsToggle" Style="{StaticResource Button.Link}" HorizontalAlignment="Left" Content="Show technical details" Click="OnToggleDetails" />
      <Border x:Name="DetailsBox" Style="{StaticResource Card}" Padding="10" Margin="0,6,0,0" Visibility="Collapsed" MaxHeight="220">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <TextBox x:Name="Details" Style="{StaticResource Text.Mono}" FontSize="11.5" TextWrapping="NoWrap" />
          </ScrollViewer>
          <Button Grid.Row="1" Style="{StaticResource Button.Link}" HorizontalAlignment="Right" Content="Copy details" Click="OnCopyDetails" Margin="0,6,0,0" />
        </Grid>
      </Border>
    </StackPanel>
    <StackPanel Grid.Row="3" x:Name="Buttons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0" />
  </Grid>
</c:ThemedWindow>
