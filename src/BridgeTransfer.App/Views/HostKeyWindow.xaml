<c:ThemedWindow x:Class="BridgeTransfer.App.Views.HostKeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:BridgeTransfer.App.Controls"
        Title="Verify the server's identity" Width="660" SizeToContent="Height" ResizeMode="NoResize">
  <StackPanel Margin="24,20,24,20">
    <StackPanel Orientation="Horizontal">
      <Border x:Name="Badge" Width="32" Height="32" CornerRadius="16" Background="{DynamicResource Brush.AccentSoft}">
        <c:Glyph x:Name="BadgeGlyph" Data="{StaticResource Icon.Shield}" Width="18" Height="18" Foreground="{DynamicResource Brush.AccentForeground}" />
      </Border>
      <TextBlock x:Name="Heading" Style="{StaticResource Text.Title}" Margin="12,5,0,0" Text="First connection to this server" />
    </StackPanel>
    <TextBlock x:Name="Intro" Style="{StaticResource Text.Muted}" Margin="44,10,0,0" />
    <Border Style="{StaticResource Card}" Margin="44,14,0,0" Padding="14,10">
      <Grid x:Name="Facts">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Server" Style="{StaticResource Text.Small}" Margin="0,4,16,4" />
        <TextBox x:Name="ServerText" Grid.Column="1" Style="{StaticResource Text.Mono}" Margin="0,4" />
        <TextBlock Grid.Row="1" Text="Key type" Style="{StaticResource Text.Small}" Margin="0,4,16,4" />
        <TextBox x:Name="AlgorithmText" Grid.Row="1" Grid.Column="1" Style="{StaticResource Text.Mono}" Margin="0,4" />
        <TextBlock x:Name="FingerprintLabel" Grid.Row="2" Text="Fingerprint" Style="{StaticResource Text.Small}" Margin="0,4,16,4" />
        <TextBox x:Name="FingerprintText" Grid.Row="2" Grid.Column="1" Style="{StaticResource Text.Mono}" FontWeight="SemiBold" Margin="0,4" />
        <TextBlock x:Name="OldLabel" Grid.Row="3" Text="Trusted before" Style="{StaticResource Text.Small}" Margin="0,4,16,4" Visibility="Collapsed" />
        <TextBox x:Name="OldText" Grid.Row="3" Grid.Column="1" Style="{StaticResource Text.Mono}" Margin="0,4" Visibility="Collapsed" />
      </Grid>
    </Border>
    <TextBlock x:Name="Advice" Style="{StaticResource Text.Muted}" Margin="44,12,0,0" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" IsDefault="True" MinWidth="96" />
      <Button x:Name="TrustButton" Style="{StaticResource Button.Primary}" Content="Trust and connect" MinWidth="140" Margin="8,0,0,0" Click="OnTrust" />
    </StackPanel>
  </StackPanel>
</c:ThemedWindow>
