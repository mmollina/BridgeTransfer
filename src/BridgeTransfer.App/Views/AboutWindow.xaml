<c:ThemedWindow x:Class="BridgeTransfer.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:BridgeTransfer.App.Controls"
        Title="About BridgeTransfer" Width="640" Height="560" MinWidth="480" MinHeight="400">
  <Grid Margin="24,20,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal">
      <Image Source="/Assets/BridgeTransfer-64.png" Width="40" Height="40" />
      <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
        <TextBlock x:Name="NameText" Style="{StaticResource Text.Title}" />
        <TextBlock Style="{StaticResource Text.Small}" Text="SFTP file transfers between this computer and a Linux VM." />
      </StackPanel>
    </StackPanel>
    <TextBlock Grid.Row="1" Style="{StaticResource Text.Section}" Text="Third-party software and licenses" Margin="0,18,0,8" />
    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="2">
      <TextBox x:Name="Notices" Style="{StaticResource Text.Mono}" FontSize="11.5" Padding="10" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
    </Border>
    <Button Grid.Row="3" Content="Close" IsCancel="True" IsDefault="True" HorizontalAlignment="Right" MinWidth="96" Margin="0,16,0,0" />
  </Grid>
</c:ThemedWindow>
