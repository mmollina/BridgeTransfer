<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Dark theme color tokens. Every style refers to these through DynamicResource. -->
  <Color x:Key="C.Window">#15171B</Color>
  <Color x:Key="C.Surface">#1D2025</Color>
  <Color x:Key="C.SurfaceAlt">#24282E</Color>
  <Color x:Key="C.SurfaceHover">#2C3138</Color>
  <Color x:Key="C.Border">#363C45</Color>
  <Color x:Key="C.BorderStrong">#4D5561</Color>
  <Color x:Key="C.Text">#E7EAEE</Color>
  <Color x:Key="C.TextMuted">#A3ACB7</Color>
  <Color x:Key="C.TextDisabled">#6B737E</Color>
  <Color x:Key="C.Accent">#2F6FD6</Color>
  <Color x:Key="C.AccentHover">#3D7FE6</Color>
  <Color x:Key="C.AccentPressed">#2860BC</Color>
  <Color x:Key="C.AccentForeground">#78ACFF</Color>
  <Color x:Key="C.AccentText">#FFFFFF</Color>
  <Color x:Key="C.AccentSoft">#1C3152</Color>
  <Color x:Key="C.AccentSoftStrong">#244271</Color>
  <Color x:Key="C.Success">#4AC26B</Color>
  <Color x:Key="C.SuccessSoft">#173322</Color>
  <Color x:Key="C.Warning">#E0A93A</Color>
  <Color x:Key="C.WarningSoft">#3A2E14</Color>
  <Color x:Key="C.Danger">#FF6B6B</Color>
  <Color x:Key="C.DangerSoft">#3D1B1D</Color>
  <Color x:Key="C.Overlay">#99000000</Color>
  <Color x:Key="C.ScrollThumb">#4B525C</Color>

  <SolidColorBrush x:Key="Brush.Window" Color="{StaticResource C.Window}" />
  <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource C.Surface}" />
  <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="{StaticResource C.SurfaceAlt}" />
  <SolidColorBrush x:Key="Brush.SurfaceHover" Color="{StaticResource C.SurfaceHover}" />
  <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource C.Border}" />
  <SolidColorBrush x:Key="Brush.BorderStrong" Color="{StaticResource C.BorderStrong}" />
  <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource C.Text}" />
  <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource C.TextMuted}" />
  <SolidColorBrush x:Key="Brush.TextDisabled" Color="{StaticResource C.TextDisabled}" />
  <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource C.Accent}" />
  <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource C.AccentHover}" />
  <SolidColorBrush x:Key="Brush.AccentPressed" Color="{StaticResource C.AccentPressed}" />
  <SolidColorBrush x:Key="Brush.AccentForeground" Color="{StaticResource C.AccentForeground}" />
  <SolidColorBrush x:Key="Brush.AccentText" Color="{StaticResource C.AccentText}" />
  <SolidColorBrush x:Key="Brush.AccentSoft" Color="{StaticResource C.AccentSoft}" />
  <SolidColorBrush x:Key="Brush.AccentSoftStrong" Color="{StaticResource C.AccentSoftStrong}" />
  <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource C.Success}" />
  <SolidColorBrush x:Key="Brush.SuccessSoft" Color="{StaticResource C.SuccessSoft}" />
  <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource C.Warning}" />
  <SolidColorBrush x:Key="Brush.WarningSoft" Color="{StaticResource C.WarningSoft}" />
  <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource C.Danger}" />
  <SolidColorBrush x:Key="Brush.DangerSoft" Color="{StaticResource C.DangerSoft}" />
  <SolidColorBrush x:Key="Brush.Overlay" Color="{StaticResource C.Overlay}" />
  <SolidColorBrush x:Key="Brush.ScrollThumb" Color="{StaticResource C.ScrollThumb}" />
</ResourceDictionary>
